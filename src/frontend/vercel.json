{
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist-demo",
  "framework": null,
  "env": {
    "VITE_DEMO_MODE": "true",
    "MINEPANEL_DEMO_OUTPUT": "workspace"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "installCommand": "npm ci --prefix ../.. --workspace minepanel-frontend --include-workspace-root=false"
}
